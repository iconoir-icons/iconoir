{
  "name": "iconoir-react",
  "version": "7.12.1",
  "description": "React components for Iconoir: 1,300+ free, open source (MIT) SVG icons with solid variants. Tree-shakable, typed, customizable size, color and stroke.",
  "license": "MIT",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/iconoir"
  },
  "homepage": "https://iconoir.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/iconoir-icons/iconoir.git",
    "directory": "packages/iconoir-react"
  },
  "keywords": [
    "icons",
    "icon-library",
    "svg-icons",
    "free-icons",
    "open-source",
    "iconoir",
    "svg",
    "react",
    "react-icons",
    "react-component"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js"
    },
    "./regular": {
      "import": "./dist/esm/regular/index.mjs",
      "require": "./dist/regular/index.js"
    },
    "./solid": {
      "import": "./dist/esm/solid/index.mjs",
      "require": "./dist/solid/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "18 || 19"
  },
  "devDependencies": {
    "@types/react": "^19.2.17"
  }
}